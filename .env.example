# AWS Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Alternative Bedrock models if Claude is not enabled in your region:
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# S3 & DynamoDB (Populated by SAM deployment outputs)
UPLOAD_BUCKET_NAME=khatalens-uploads-prod
DYNAMODB_TABLE_NAME=khatalens-entries-prod

# API Gateway URL (Configured in frontend)
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_MODE=true
